generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

enum HouseholdRole {
  OWNER
  MEMBER
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int              @id @default(autoincrement())
  guid            String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  email           String           @unique
  phone           String           @unique
  firstName       String
  lastName        String
  password        String
  memberships       HouseholdMembership[]
  createdInvitations HouseholdInvitation[] @relation("InvitationCreator")
  acceptedInvitations HouseholdInvitation[] @relation("InvitationAccepter")
  responsibilites Responsibility[]
  session         String?          @unique
  refreshToken    String?          @unique
}

model Household {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
   addressId   Int?
   address     Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  tasks       Task[]
  memberships HouseholdMembership[]
  invitations HouseholdInvitation[]
}

model HouseholdMembership {
  id          Int           @id @default(autoincrement())
  publicId    String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      Int
  householdId Int
  role        HouseholdRole
  joinedAt    DateTime      @default(now())
  leftAt      DateTime?
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([householdId])
  @@index([userId])
}

model HouseholdInvitation {
  id               Int       @id @default(autoincrement())
  publicId         String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  householdId      Int
  createdByUserId  Int
  tokenHash        String    @unique
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId Int?
  revokedAt        DateTime?
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy        User      @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?     @relation("InvitationAccepter", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([householdId, expiresAt])
}

model Address {
  id           Int         @id @default(autoincrement())
  streetName   String
  streetNumber Int
  postalCode   String
  state        String
  city         String
  country      String
  household    Household[]
}

model Task {
  id            Int       @id @default(autoincrement())
  householdTask Household @relation(fields: [id], references: [id])
}

model Responsibility {
  id           Int    @id @default(autoincrement())
  assignedUser User   @relation(fields: [id], references: [id])
  description  String
}
